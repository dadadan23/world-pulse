{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./.agentx/agentx.sh ready)",
      "Bash(./.agentx/agentx.sh state)",
      "Bash(./.agentx/agentx.sh deps:*)",
      "Bash(./.agentx/agentx.sh workflow:*)",
      "Bash(./.agentx/agentx.sh hook:*)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run validate)",
      "Bash(npx vitest run:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(npm install -g:*)",
      "Read(./.env.local)"
    ]
  }
}
